<!DOCTYPE html>
<html lang="ko">
<head>
<meta charset="UTF-8" />
<meta name="viewport" content="width=device-width, initial-scale=1.0" />
<title>Pixel Flower Widget</title>

<style>
  html, body {
    margin: 0;
    padding: 0;
    background: transparent;
    overflow: hidden;
  }

  canvas {
    display: block;
    image-rendering: pixelated;
  }
</style>
</head>
<body>

<canvas id="canvas"></canvas>

<script>
/* =====================
   CONFIG (Notion-safe)
===================== */
const VIEW_W = 300;
const VIEW_H = 300;
const PIXEL = 4;

const BOX_MARGIN = 20;
const BOX_SIZE = VIEW_W - BOX_MARGIN * 2;

/* =====================
   COLORS (Pastel)
===================== */
const COLORS = {
  frameLight: "#e6dcff",
  frameDark: "#c2b7f2",
  sky: "#e8f4ff",
  petals: ["#ffd1e8", "#ffc4dd", "#ffe0f0"]
};

/* =====================
   Canvas Setup
===================== */
const canvas = document.getElementById("canvas");
canvas.width = VIEW_W;
canvas.height = VIEW_H;

const ctx = canvas.getContext("2d");

/* =====================
   Pixel Flower
===================== */
class Petal {
  constructor() {
    this.reset();
  }

  reset() {
    this.x = BOX_MARGIN + Math.random() * BOX_SIZE;
    this.y = BOX_MARGIN - 20;
    this.speed = 0.25 + Math.random() * 0.4;
    this.color = COLORS.petals[Math.floor(Math.random() * COLORS.petals.length)];
  }

  update() {
    this.y += this.speed;
    if (this.y > BOX_MARGIN + BOX_SIZE + 20) {
      this.reset();
    }
  }

  draw() {
    const pattern = [
      [0,1,0],
      [1,1,1],
      [0,1,0]
    ];

    ctx.fillStyle = this.color;
    for (let r = 0; r < 3; r++) {
      for (let c = 0; c < 3; c++) {
        if (pattern[r][c]) {
          ctx.fillRect(
            Math.floor(this.x / PIXEL) * PIXEL + c * PIXEL,
            Math.floor(this.y / PIXEL) * PIXEL + r * PIXEL,
            PIXEL,
            PIXEL
          );
        }
      }
    }
  }
}

/* =====================
   Draw Frame
===================== */
function drawFrame() {
  ctx.fillStyle = COLORS.frameLight;
  ctx.fillRect(
    BOX_MARGIN - 10,
    BOX_MARGIN - 10,
    BOX_SIZE + 20,
    BOX_SIZE + 20
  );

  ctx.strokeStyle = COLORS.frameDark;
  ctx.lineWidth = 4;
  ctx.strokeRect(
    BOX_MARGIN - 10,
    BOX_MARGIN - 10,
    BOX_SIZE + 20,
    BOX_SIZE + 20
  );
}

/* =====================
   Draw Sky
===================== */
function drawSky() {
  ctx.fillStyle = COLORS.sky;
  ctx.fillRect(BOX_MARGIN, BOX_MARGIN, BOX_SIZE, BOX_SIZE);
}

/* =====================
   Init
===================== */
const petals = Array.from({ length: 14 }, () => new Petal());

/* =====================
   Loop
===================== */
function loop() {
  ctx.clearRect(0, 0, VIEW_W, VIEW_H);

  drawFrame();
  drawSky();

  ctx.save();
  ctx.beginPath();
  ctx.rect(BOX_MARGIN, BOX_MARGIN, BOX_SIZE, BOX_SIZE);
  ctx.clip();

  petals.forEach(p => {
    p.update();
    p.draw();
  });

  ctx.restore();

  requestAnimationFrame(loop);
}

loop();
</script>

</body>
</html>
